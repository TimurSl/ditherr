// Ditherr look, format version 1
(
    version: 1,
    name: "RGB 3-3-2, Sierra Lite",
    preprocess: [],
    pixel_scale: 1,
    palette: Levels(
        r: 8,
        g: 8,
        b: 4,
    ),
    metric: Oklab,
    algorithm: ErrorDiffusion(SierraLite),
    params: (
        strength: 0.9,
        serpentine: true,
        scan: LeftToRight,
        bias: 0.0,
        jitter: 0.0,
        error_clamp: Auto,
        linear_light: true,
        seed: 0,
    ),
    background: (255, 255, 255),
)
